.page-create {
  min-height: 100vh;
  background-color: var(--td-bg-color-page);
}

.form-card {
  margin: 24rpx 32rpx;
  background: var(--td-bg-color-container);
  border-radius: 24rpx;
  padding: 32rpx 32rpx;
}

.form-item {
  margin-bottom: 36rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--td-text-color-primary);
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: var(--td-bg-color-secondarycontainer);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-picker {
  width: 100%;
  height: 80rpx;
  background: var(--td-bg-color-secondarycontainer);
  border-radius: 12rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  font-size: 28rpx;
  color: var(--td-text-color-primary);
}

.form-picker .placeholder {
  color: var(--td-text-color-placeholder);
}

.picker-arrow {
  font-size: 32rpx;
  color: var(--td-text-color-placeholder);
}

.color-options {
  display: flex;
  gap: 20rpx;
}

.color-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid transparent;
  transition: all 0.2s;
}

.color-dot.selected {
  border-color: var(--td-text-color-primary);
  transform: scale(1.15);
}

.check-icon {
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}

.member-input-wrap {
  display: flex;
  align-items: center;
}

.member-input-wrap .form-input {
  flex: 1;
}

.add-member-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 26rpx;
  color: var(--travel-brand, #38C172);
  font-weight: 500;
}

.member-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
  gap: 12rpx;
}

.member-tag {
  background: var(--travel-brand, #38C172);
  color: #fff;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  display: flex;
  align-items: center;
}

.member-remove {
  margin-left: 8rpx;
  font-size: 24rpx;
  opacity: 0.8;
}

.submit-section {
  padding: 32rpx;
}
