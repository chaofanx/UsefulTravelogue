<view class="page-create">
  <nav-bar title="新建账本" leftArrow />

  <view class="form-card">
    <view class="form-item">
      <view class="form-label">账本名称</view>
      <input
        class="form-input"
        placeholder="输入账本名称，如「五一北京」"
        value="{{name}}"
        bindinput="onNameInput"
      />
    </view>

    <view class="form-item">
      <view class="form-label">旅行开始日期</view>
      <picker mode="date" value="{{startDate}}" bindchange="onStartDateChange">
        <view class="form-picker">
          <text class="{{startDate ? '' : 'placeholder'}}">{{startDate || '选择开始日期'}}</text>
          <app-icon class="picker-arrow" name="chevron-right" size="{{32}}" color="#a6a6a6" />
        </view>
      </picker>
    </view>

    <view class="form-item">
      <view class="form-label">旅行结束日期</view>
      <picker mode="date" value="{{endDate}}" start="{{startDate}}" bindchange="onEndDateChange">
        <view class="form-picker">
          <text class="{{endDate ? '' : 'placeholder'}}">{{endDate || '选择结束日期'}}</text>
          <app-icon class="picker-arrow" name="chevron-right" size="{{32}}" color="#a6a6a6" />
        </view>
      </picker>
    </view>

    <view class="form-item">
      <view class="form-label">封面颜色</view>
      <view class="color-options">
        <view
          wx:for="{{colors}}"
          wx:key="*this"
          class="color-dot {{coverColor === item ? 'selected' : ''}}"
          style="background-color: {{item}}"
          data-color="{{item}}"
          bindtap="onColorTap"
        >
          <app-icon wx:if="{{coverColor === item}}" class="check-icon" name="check" size="{{28}}" color="#ffffff" />
        </view>
      </view>
    </view>

    <view class="form-item">
      <view class="form-label">添加成员</view>
      <view class="member-input-wrap">
        <input
          class="form-input"
          placeholder="输入成员名称"
          value="{{memberInput}}"
          bindinput="onMemberInput"
          bindconfirm="onAddMember"
        />
        <view class="add-member-btn" bindtap="onAddMember">
          <text>+ 添加</text>
        </view>
      </view>
      <view class="member-list" wx:if="{{members.length > 0}}">
        <view class="member-tag" wx:for="{{members}}" wx:key="*this">
          <text>{{item}}</text>
          <app-icon class="member-remove" data-index="{{index}}" bindtap="onRemoveMember" name="close" size="{{24}}" color="#ffffff" />
        </view>
      </view>
    </view>
  </view>

  <view class="submit-section">
    <t-button
      theme="primary"
      size="large"
      block
      disabled="{{!name || !startDate || !endDate}}"
      bind:tap="onSubmit"
      style="background-color: var(--travel-brand, #38C172); border-color: var(--travel-brand, #38C172);"
    >
      创建账本
    </t-button>
  </view>
</view>
