.page-bill {
  min-height: 100vh;
  background-color: var(--td-bg-color-page);
  display: flex;
  flex-direction: column;
  padding-bottom: calc(100rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
}

.bill-content {
  flex: 1;
  padding: 0 32rpx;
  margin-top: -24rpx;
  position: relative;
  z-index: 2;
}

.bill-list-card {
  background: var(--td-bg-color-container);
  border-radius: 24rpx;
  padding: 0 28rpx;
  min-height: 200rpx;
}

.empty-bill {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  font-size: 28rpx;
  color: var(--td-text-color-placeholder);
}

.empty-icon-text {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

.float-btn {
  position: fixed;
  right: 32rpx;
  bottom: calc(170rpx + constant(safe-area-inset-bottom));
  bottom: calc(170rpx + env(safe-area-inset-bottom));
  width: 200rpx;
  height: 80rpx;
  background: var(--travel-brand, #38C172);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(56, 193, 114, 0.35);
  z-index: 99;
}

.float-icon {
  font-size: 32rpx;
  color: #fff;
}

.float-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
  margin-left: 8rpx;
}
