.page-bill {
  min-height: 100vh;
  background-color: var(--td-bg-color-page);
  display: flex;
  flex-direction: column;
  padding-bottom: calc(100rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
}

.bill-content {
  flex: 1;
  padding: 0 32rpx;
  margin-top: -24rpx;
  position: relative;
  z-index: 2;
}

.bill-list-card {
  background: var(--td-bg-color-container);
  border-radius: 24rpx;
  padding: 0 28rpx;
  min-height: 200rpx;
}

.empty-bill {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  font-size: 28rpx;
  color: var(--td-text-color-placeholder);
}

.empty-icon-text {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

.float-btn {
  position: fixed;
  right: 32rpx;
  bottom: calc(170rpx + constant(safe-area-inset-bottom));
  bottom: calc(170rpx + env(safe-area-inset-bottom));
  width: 200rpx;
  height: 80rpx;
  background: var(--travel-brand, #38C172);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(56, 193, 114, 0.35);
  z-index: 99;
}

.float-icon {
  font-size: 32rpx;
  color: #fff;
}

.float-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
  margin-left: 8rpx;
}

/* ========== 记账表单弹层 ========== */

.bill-form-popup {
  background: var(--td-bg-color-container);
  border-radius: 32rpx 32rpx 0 0;
  padding: 0 32rpx 32rpx;
  padding-bottom: calc(32rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.popup-handle {
  display: flex;
  justify-content: center;
  padding: 20rpx 0 12rpx;
}

.handle-bar {
  width: 64rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--td-component-stroke);
}

.popup-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--td-text-color-primary);
  text-align: center;
  margin-bottom: 28rpx;
}

.form-scroll {
  flex: 1;
  overflow-y: auto;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--td-text-color-primary);
  margin-bottom: 16rpx;
}

.amount-input-wrap {
  display: flex;
  align-items: center;
  border-bottom: 4rpx solid var(--travel-brand, #38C172);
  padding-bottom: 16rpx;
}

.currency {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--td-text-color-primary);
  margin-right: 16rpx;
}

.amount-input {
  flex: 1;
  font-size: 48rpx;
  font-weight: 700;
  color: var(--td-text-color-primary);
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: var(--td-bg-color-secondarycontainer);
  min-width: 120rpx;
}

.category-item.active {
  background: var(--travel-brand, #38C172);
}

.category-item.active .cat-name {
  color: #fff;
}

.cat-emoji {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.cat-name {
  font-size: 22rpx;
  color: var(--td-text-color-secondary);
}

.payer-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.payer-item {
  padding: 14rpx 28rpx;
  border-radius: 12rpx;
  background: var(--td-bg-color-secondarycontainer);
  font-size: 26rpx;
  color: var(--td-text-color-secondary);
}

.payer-item.active {
  background: var(--travel-brand, #38C172);
  color: #fff;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: var(--td-bg-color-secondarycontainer);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.delete-section {
  text-align: center;
  padding: 16rpx 0 8rpx;
}

.delete-text {
  font-size: 26rpx;
  color: #FF6B6B;
}

.popup-footer {
  display: flex;
  gap: 20rpx;
  padding-top: 24rpx;
}

.footer-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
}

.cancel-btn {
  background: var(--td-bg-color-secondarycontainer);
  color: var(--td-text-color-secondary);
}

.confirm-btn {
  background: var(--travel-brand, #38C172);
  color: #fff;
}
