<view class="page-bill">
  <!-- 隐藏画布：用于绘制分享封面图（Skyline 下 canvas 不能移出渲染树，用透明隐藏） -->
  <canvas type="2d" id="shareCanvas" class="share-canvas" />

  <book-header book="{{book}}" bind:bookchange="onBookChange" />

  <view class="bill-content">
    <view class="bill-list-card">
      <bill-group
        wx:for="{{groupedBills}}"
        wx:key="date"
        group="{{item}}"
        bind:billtap="onBillTap"
      />
      <view wx:if="{{groupedBills.length === 0}}" class="empty-bill">
        <text class="empty-icon-text">📝</text>
        <text>暂无账单记录</text>
      </view>
    </view>
  </view>

  <view class="float-btn" bindtap="onAddBill">
    <text class="float-icon">✏️</text>
    <text class="float-text">记一笔</text>
  </view>

  <custom-tab-bar current="bill" bookId="{{bookId}}" bind:change="onTabChange" />

  <t-popup visible="{{showFormPopup}}" placement="bottom" bind:visible-change="onFormPopupVisible">
    <view class="bill-form-popup">
      <view class="popup-handle">
        <view class="handle-bar"></view>
      </view>
      <view class="popup-title">{{editingId ? '编辑账单' : '记一笔'}}</view>

      <view class="form-scroll">
        <view class="form-item">
          <view class="form-label">金额</view>
          <view class="amount-input-wrap">
            <text class="currency">¥</text>
            <input
              class="amount-input"
              type="digit"
              placeholder="0.00"
              value="{{formAmount}}"
              bindinput="onAmountInput"
              focus="{{!editingId}}"
            />
          </view>
        </view>

        <view class="form-item">
          <view class="form-label">日期</view>
          <view class="payer-options">
            <view
              class="payer-item {{formDate === todayStr ? 'active' : ''}}"
              data-date="{{todayStr}}"
              bindtap="onDateQuick"
            >
              <text>今天</text>
            </view>
            <view
              class="payer-item {{formDate === yesterdayStr ? 'active' : ''}}"
              data-date="{{yesterdayStr}}"
              bindtap="onDateQuick"
            >
              <text>昨天</text>
            </view>
            <picker mode="date" value="{{formDate}}" bindchange="onDatePick">
              <view class="payer-item {{formDate !== todayStr && formDate !== yesterdayStr ? 'active' : ''}}">
                <text>{{formDate !== todayStr && formDate !== yesterdayStr ? formDate : '选其他日期'}}</text>
              </view>
            </picker>
          </view>
        </view>

        <view class="form-item">
          <view class="form-label">分类</view>
          <view class="category-grid">
            <view
              wx:for="{{categories}}"
              wx:key="name"
              class="category-item {{formCategory === item.name ? 'active' : ''}}"
              data-name="{{item.name}}"
              bindtap="onCategoryTap"
            >
              <text class="cat-emoji">{{item.name === '其他' && formIcon ? formIcon : item.icon}}</text>
              <text class="cat-name">{{item.name}}</text>
            </view>
          </view>
        </view>

        <view wx:if="{{formCategory === '其他' && otherEmojis.length > 0}}" class="form-item">
          <view class="form-label">更换图标（其他分类）</view>
          <view class="emoji-grid">
            <view
              wx:for="{{otherEmojis}}"
              wx:key="*this"
              class="emoji-item {{formIcon === item ? 'active' : ''}}"
              data-emoji="{{item}}"
              bindtap="onEmojiTap"
            >
              <text>{{item}}</text>
            </view>
          </view>
        </view>

        <view class="form-item">
          <view class="form-label">付款人</view>
          <view class="payer-options">
            <view
              wx:for="{{payers}}"
              wx:key="*this"
              class="payer-item {{formPayer === item ? 'active' : ''}}"
              data-name="{{item}}"
              bindtap="onPayerTap"
            >
              <text>{{memberAliases[item] || item}}</text>
            </view>
          </view>
        </view>

        <view class="form-item">
          <view class="form-label">参与分摊的人</view>
          <view class="payer-options">
            <view
              wx:for="{{payers}}"
              wx:key="*this"
              class="payer-item {{participantMap[item] ? 'active' : ''}}"
              data-name="{{item}}"
              bindtap="onParticipantTap"
            >
              <text>{{memberAliases[item] || item}}</text>
            </view>
          </view>
        </view>

        <view wx:if="{{isVip}}" class="form-item">
          <view class="form-label">备注 <text class="vip-tag">VIP</text></view>
          <input
            class="form-input"
            placeholder="添加备注（选填）"
            value="{{formRemark}}"
            bindinput="onRemarkInput"
          />
        </view>

        <view wx:if="{{isVip}}" class="form-item exclude-row">
          <view class="exclude-label-wrap">
            <view class="form-label">不计入分账 <text class="vip-tag">VIP</text></view>
            <text class="exclude-hint">已提前分账好的支出可开启</text>
          </view>
          <switch checked="{{formExclude}}" bindchange="onExcludeChange" color="#38C172" />
        </view>

        <view wx:if="{{editingId}}" class="delete-section" bindtap="onDeleteBill">
          <text class="delete-text">删除此账单</text>
        </view>
      </view>

      <view class="popup-footer">
        <view class="footer-btn cancel-btn" bindtap="onCancelForm">取消</view>
        <view class="footer-btn confirm-btn" bindtap="onConfirmBill">{{editingId ? '保存' : '记账'}}</view>
      </view>
    </view>
  </t-popup>
</view>
