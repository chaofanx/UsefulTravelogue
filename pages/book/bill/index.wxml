<wxs module="cat" src="../../../utils/category.wxs" />
<view class="page-bill">
  <!-- 隐藏画布：用于绘制分享封面图（Skyline 下 canvas 不能移出渲染树，用透明隐藏） -->
  <canvas type="2d" id="shareCanvas" class="share-canvas" />

  <book-header book="{{book}}" bind:bookchange="onBookChange" />

  <view class="bill-content">
    <view class="bill-list-card">
      <bill-group
        wx:for="{{groupedBills}}"
        wx:key="date"
        group="{{item}}"
        bind:billtap="onBillTap"
      />
      <view wx:if="{{groupedBills.length === 0}}" class="empty-bill">
        <app-icon class="empty-icon-text" name="notebook" size="{{88}}" color="#c5c5c5" />
        <text>暂无账单记录</text>
      </view>
    </view>
  </view>

  <view class="float-btn" bindtap="onAddBill">
    <app-icon class="float-icon" name="edit" size="{{36}}" color="#ffffff" />
    <text class="float-text">记一笔</text>
  </view>

  <custom-tab-bar current="bill" bookId="{{bookId}}" bind:change="onTabChange" />

  <t-popup visible="{{showFormPopup}}" placement="bottom" bind:visible-change="onFormPopupVisible">
    <view class="bill-form-popup">
      <view class="popup-handle">
        <view class="handle-bar"></view>
      </view>
      <view class="popup-title">{{editingId ? '编辑账单' : '记一笔'}}</view>

      <scroll-view scroll-y class="form-scroll">
        <view class="form-item">
          <view class="form-label">金额</view>
          <view class="amount-input-wrap">
            <picker
              class="currency-picker"
              range="{{currencyLabels}}"
              value="{{currencyIndex}}"
              disabled="{{currencyLabels.length < 2}}"
              bindchange="onCurrencyChange"
            >
              <text class="currency">{{currencySymbol}}</text>
              <app-icon wx:if="{{currencyLabels.length > 1}}" class="currency-arrow" name="chevron-down" size="{{28}}" color="#a6a6a6" />
            </picker>
            <input
              class="amount-input"
              type="digit"
              placeholder="0.00"
              value="{{formAmount}}"
              bindinput="onAmountInput"
              focus="{{!editingId}}"
            />
          </view>
          <view wx:if="{{convertText}}" class="convert-text">{{convertText}}</view>
        </view>

        <view class="form-item">
          <view class="form-label">日期<text wx:if="{{minDateStr}}" class="date-lock-tip">（{{minDateStr}} 至 {{maxDateStr}}）</text></view>
          <view class="payer-options">
            <view
              wx:if="{{(!minDateStr || todayStr >= minDateStr) && (!maxDateStr || todayStr <= maxDateStr)}}"
              class="payer-item {{formDate === todayStr ? 'active' : ''}}"
              data-date="{{todayStr}}"
              bindtap="onDateQuick"
            >
              <text>今天</text>
            </view>
            <view
              wx:if="{{(!minDateStr || yesterdayStr >= minDateStr) && (!maxDateStr || yesterdayStr <= maxDateStr)}}"
              class="payer-item {{formDate === yesterdayStr ? 'active' : ''}}"
              data-date="{{yesterdayStr}}"
              bindtap="onDateQuick"
            >
              <text>昨天</text>
            </view>
            <picker mode="date" value="{{formDate}}" start="{{minDateStr}}" end="{{maxDateStr}}" bindchange="onDatePick">
              <view class="payer-item {{formDate !== todayStr && formDate !== yesterdayStr ? 'active' : ''}}">
                <text>{{formDate !== todayStr && formDate !== yesterdayStr ? formDate : '选其他日期'}}</text>
              </view>
            </picker>
          </view>
        </view>

        <view class="form-item">
          <view class="form-label">分类</view>
          <scroll-view class="category-grid" scroll-x enable-flex show-scrollbar="{{false}}">
            <view
              wx:for="{{categories}}"
              wx:key="name"
              class="category-item {{formCategory === item.name ? 'active' : ''}}"
              data-name="{{item.name}}"
              bindtap="onCategoryTap"
            >
              <app-icon wx:if="{{!(item.name === '其他' && formIcon)}}" class="cat-icon" name="{{cat.key(item.name)}}" size="{{40}}" color="{{formCategory === item.name ? '#ffffff' : cat.color(item.name)}}" />
              <text wx:else class="cat-emoji">{{formIcon}}</text>
              <text class="cat-name">{{item.name}}</text>
            </view>
          </scroll-view>
        </view>

        <view wx:if="{{formCategory === '其他' && otherEmojis.length > 0}}" class="form-item">
          <view class="form-label">更换图标（其他分类）</view>
          <view class="emoji-grid">
            <view
              wx:for="{{otherEmojis}}"
              wx:key="*this"
              class="emoji-item {{formIcon === item ? 'active' : ''}}"
              data-emoji="{{item}}"
              bindtap="onEmojiTap"
            >
              <text>{{item}}</text>
            </view>
          </view>
        </view>

        <view class="form-item">
          <view class="form-label">付款人</view>
          <view class="payer-options">
            <view
              wx:for="{{members}}"
              wx:key="id"
              class="payer-item {{formPayerId === item.id ? 'active' : ''}}"
              data-id="{{item.id}}"
              bindtap="onPayerTap"
            >
              <text>{{memberAliases[item.name] || item.name}}</text>
            </view>
          </view>
        </view>

        <view class="form-item">
          <view class="form-label">参与分摊的人</view>
          <view class="payer-options">
            <view
              wx:for="{{members}}"
              wx:key="id"
              class="payer-item {{participantMap[item.id] ? 'active' : ''}}"
              data-id="{{item.id}}"
              bindtap="onParticipantTap"
            >
              <text>{{memberAliases[item.name] || item.name}}</text>
            </view>
          </view>
        </view>

        <view wx:if="{{isVip}}" class="form-item">
          <view class="form-label">备注 <text class="vip-tag">VIP</text></view>
          <input
            class="form-input"
            placeholder="添加备注（选填）"
            value="{{formRemark}}"
            bindinput="onRemarkInput"
          />
        </view>

        <view wx:if="{{isVip}}" class="form-item exclude-row">
          <view class="exclude-label-wrap">
            <view class="form-label">不计入分账 <text class="vip-tag">VIP</text></view>
            <text class="exclude-hint">已提前分账好的支出可开启</text>
          </view>
          <switch checked="{{formExclude}}" bindchange="onExcludeChange" color="#38C172" />
        </view>

        <view wx:if="{{editingId}}" class="delete-section" bindtap="onDeleteBill">
          <text class="delete-text">删除此账单</text>
        </view>
      </scroll-view>

      <view class="popup-footer">
        <view class="footer-btn cancel-btn" bindtap="onCancelForm">取消</view>
        <view class="footer-btn confirm-btn" bindtap="onConfirmBill">{{editingId ? '保存' : '记账'}}</view>
      </view>
    </view>
  </t-popup>
</view>
