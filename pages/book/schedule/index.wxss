.page-schedule {
  min-height: 100vh;
  background-color: var(--td-bg-color-page);
  display: flex;
  flex-direction: column;
  padding-bottom: calc(100rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
}

.schedule-content {
  flex: 1;
  padding: 0 32rpx;
  margin-top: -24rpx;
  position: relative;
  z-index: 2;
}

.ticket-card {
  background: var(--td-bg-color-container);
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.ticket-left {
  flex: 1;
}

.ticket-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--td-text-color-primary);
  display: block;
}

.ticket-desc {
  font-size: 24rpx;
  color: var(--td-text-color-placeholder);
  margin-top: 6rpx;
  display: block;
}

.ticket-right {
  display: flex;
  align-items: center;
}

.ticket-icon {
  font-size: 48rpx;
  margin-right: 12rpx;
}

.ticket-arrow {
  font-size: 36rpx;
  color: var(--td-text-color-placeholder);
}

.schedule-timeline-card {
  background: var(--td-bg-color-container);
  border-radius: 32rpx;
  padding: 28rpx 32rpx;
  min-height: 200rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
}

.date-section {
  margin-bottom: 16rpx;
}

.date-section:last-child {
  margin-bottom: 0;
}

.date-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0 20rpx;
}

.date-text {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--td-text-color-primary);
}

.date-more {
  font-size: 32rpx;
  color: var(--td-text-color-placeholder);
  letter-spacing: 4rpx;
}

.empty-schedule {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  font-size: 28rpx;
  color: var(--td-text-color-placeholder);
}

.float-btn {
  position: fixed;
  right: 32rpx;
  bottom: calc(170rpx + constant(safe-area-inset-bottom));
  bottom: calc(170rpx + env(safe-area-inset-bottom));
  width: 216rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #38C172 0%, #2ba461 100%);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 28rpx rgba(56, 193, 114, 0.38);
  z-index: 99;
}

.float-icon {
  font-size: 32rpx;
  color: #fff;
}

.float-text {
  font-size: 30rpx;
  color: #fff;
  font-weight: 600;
  margin-left: 8rpx;
}

.schedule-form-popup {
  background: var(--td-bg-color-container);
  border-radius: 40rpx 40rpx 0 0;
  padding: 0 32rpx 32rpx;
  padding-bottom: calc(32rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.form-scroll {
  max-height: calc(80vh - 360rpx);
}

.location-picker {
  display: flex;
  align-items: center;
  background: var(--td-bg-color-secondarycontainer);
  border-radius: 24rpx;
  padding: 0 28rpx;
  height: 96rpx;
}

.location-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.location-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--td-text-color-primary);
}

.location-text.placeholder {
  color: var(--td-text-color-placeholder);
}

.location-arrow {
  font-size: 30rpx;
  color: var(--td-text-color-placeholder);
}

.period-row {
  display: flex;
  gap: 16rpx;
}

/* picker 作为 flex 子项与快捷选项等宽 */
.period-row picker {
  flex: 1;
  display: flex;
}

.period-item {
  flex: 1;
  height: 80rpx;
  border-radius: 999px;
  background: var(--td-bg-color-secondarycontainer);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--td-text-color-secondary);
}

.period-item.active {
  background: var(--travel-brand, #38C172);
  color: #fff;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  background: var(--td-bg-color-secondarycontainer);
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: var(--td-text-color-primary);
  box-sizing: border-box;
}

.char-count {
  text-align: right;
  font-size: 22rpx;
  color: var(--td-text-color-placeholder);
  margin-top: 8rpx;
  display: block;
}

.delete-section {
  text-align: center;
  padding: 16rpx 0 8rpx;
}

.delete-text {
  font-size: 26rpx;
  color: #FF6B6B;
}

.footer-btn {
  flex: 1;
  height: 92rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
}

.cancel-btn {
  background: var(--td-bg-color-secondarycontainer);
  color: var(--td-text-color-secondary);
}

.confirm-btn {
  background: var(--travel-brand, #38C172);
  color: #fff;
}

.date-picker {
  flex: 1.6;
}
