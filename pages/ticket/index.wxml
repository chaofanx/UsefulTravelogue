<view class="page-ticket">
  <nav-bar title="行程票根" leftArrow />

  <view class="ticket-content">
    <view wx:if="{{ticket}}" class="ticket-preview">
      <view class="ticket-card-stub">
        <view class="ticket-top">
          <text class="ticket-type">🎟️ 行程票根</text>
          <text class="ticket-code">NO. {{book.title || ''}} 第{{ticket.id}}号</text>
        </view>
        <view class="ticket-body">
          <view class="ticket-route">
            <text class="route-from">{{book.title || ''}}</text>
            <text class="route-arrow">→</text>
            <text class="route-to">{{ticket.location}}</text>
          </view>
          <view class="ticket-info-row">
            <text>日期：{{formattedDate}}</text>
            <text>时间：{{ticket.period || '全天'}}</text>
          </view>
          <view class="ticket-info-row">
            <text>人数：{{memberCount}}人</text>
            <text>贡献者：{{ticket.contributor || ''}}</text>
          </view>
        </view>
        <view class="ticket-bottom">
          <view class="ticket-perforation"></view>
          <text class="ticket-footer-text">好用旅记 · 记录每一次美好旅程</text>
        </view>
      </view>
    </view>

    <view wx:else class="ticket-empty">
      <text>暂无行程记录</text>
    </view>
  </view>
</view>
