.page-ticket {
  min-height: 100vh;
  background-color: var(--td-bg-color-page);
}

.ticket-content {
  padding: 40rpx 32rpx;
}

.ticket-preview {
  margin-bottom: 40rpx;
}

.ticket-card-stub {
  background: var(--td-bg-color-container);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

.ticket-top {
  background: linear-gradient(135deg, #FF8C42, #FF6B6B);
  padding: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.ticket-type {
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
}

.ticket-code {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

.ticket-body {
  padding: 32rpx;
}

.ticket-route {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.route-from,
.route-to {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--td-text-color-primary);
}

.route-arrow {
  font-size: 36rpx;
  color: var(--td-text-color-placeholder);
  margin: 0 24rpx;
}

.ticket-info-row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: var(--td-text-color-secondary);
  margin-bottom: 12rpx;
}

.ticket-bottom {
  position: relative;
  padding: 24rpx 32rpx;
  border-top: 2rpx dashed var(--td-component-stroke);
  display: flex;
  justify-content: center;
}

.ticket-perforation {
  position: absolute;
  top: -16rpx;
  left: -16rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background-color: var(--td-bg-color-page);
}

.ticket-perforation::after {
  content: '';
  position: absolute;
  top: -16rpx;
  right: 0;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background-color: #fff;
}

.ticket-footer-text {
  font-size: 22rpx;
  color: var(--td-text-color-placeholder);
  text-align: center;
}
