<view class="page-detail">
  <nav-bar title="{{book.title}}" leftArrow />

  <view class="detail-cover" style="background-color: {{book.coverColor || '#4A90D9'}}">
    <text class="cover-title">{{book.title}}</text>
    <text class="cover-date">{{book.date}}</text>
  </view>

  <view class="join-banner" wx:if="{{isInvited && !isMember}}">
    <text class="join-text">你被邀请加入此账本</text>
    <button class="join-btn" bindtap="onJoinBook">加入账本</button>
  </view>

  <view class="detail-menu">
    <view class="menu-item" bindtap="onGoBill">
      <app-icon class="menu-icon" name="bill" size="{{44}}" color="#38C172" />
      <text class="menu-text">账单</text>
      <app-icon class="menu-arrow" name="chevron-right" size="{{32}}" color="#a6a6a6" />
    </view>
    <view class="menu-item" bindtap="onGoSchedule">
      <app-icon class="menu-icon" name="schedule" size="{{44}}" color="#38C172" />
      <text class="menu-text">行程</text>
      <app-icon class="menu-arrow" name="chevron-right" size="{{32}}" color="#a6a6a6" />
    </view>
    <view class="menu-item" bindtap="onGoStatistics">
      <app-icon class="menu-icon" name="statistics" size="{{44}}" color="#38C172" />
      <text class="menu-text">分账统计</text>
      <app-icon class="menu-arrow" name="chevron-right" size="{{32}}" color="#a6a6a6" />
    </view>
  </view>
</view>
