.page-add-bill {
  min-height: 100vh;
  background-color: var(--td-bg-color-page);
}

.form-card {
  margin: 24rpx 32rpx;
  background: var(--td-bg-color-container);
  border-radius: 24rpx;
  padding: 32rpx 32rpx;
}

.form-item {
  margin-bottom: 36rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--td-text-color-primary);
  margin-bottom: 20rpx;
}

.amount-input-wrap {
  display: flex;
  align-items: center;
  border-bottom: 4rpx solid var(--travel-brand, #38C172);
  padding-bottom: 16rpx;
}

.currency {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--td-text-color-primary);
  margin-right: 16rpx;
}

.amount-input {
  flex: 1;
  font-size: 48rpx;
  font-weight: 700;
  color: var(--td-text-color-primary);
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: var(--td-bg-color-secondarycontainer);
  min-width: 120rpx;
}

.category-item.active {
  background: var(--travel-brand, #38C172);
}

.category-item.active .cat-name {
  color: #fff;
}

.cat-emoji {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.cat-name {
  font-size: 22rpx;
  color: var(--td-text-color-secondary);
}

.payer-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.payer-item {
  padding: 14rpx 28rpx;
  border-radius: 12rpx;
  background: var(--td-bg-color-secondarycontainer);
  font-size: 26rpx;
  color: var(--td-text-color-secondary);
}

.payer-item.active {
  background: var(--travel-brand, #38C172);
  color: #fff;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: var(--td-bg-color-secondarycontainer);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.submit-section {
  padding: 32rpx;
}

.delete-section {
  text-align: center;
  padding: 28rpx 0;
}

.delete-text {
  font-size: 28rpx;
  color: #FF6B6B;
}
