<view class="page-profile">
  <nav-bar title="个人中心" leftArrow />

  <view class="profile-card">
    <view class="avatar-section">
      <button class="avatar-picker-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{userInfo.avatar}}" class="avatar-img" src="{{userInfo.avatar}}" mode="aspectFill" />
        <view wx:else class="avatar-circle" style="background-color: #38C172">
          <text class="avatar-char">{{userInfo.nickname ? userInfo.nickname.charAt(0) : ''}}</text>
        </view>
      </button>
      <view class="user-info">
        <input
          class="nickname-input"
          type="nickname"
          value="{{userInfo.nickname || ''}}"
          placeholder="点击设置昵称"
          maxlength="20"
          bindblur="onNicknameSave"
        />
        <text class="user-desc">{{userInfo.vip ? 'VIP会员' : '旅行记账达人'}}</text>
      </view>
    </view>
  </view>

  <view class="menu-card">
    <view class="menu-item" bindtap="onMenuItem" data-type="vip">
      <text class="menu-icon">💎</text>
      <text class="menu-text">会员中心</text>
      <text class="menu-badge">{{userInfo.vip ? 'VIP用户' : '免费用户'}}</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onMenuItem" data-type="stats">
      <text class="menu-icon">📊</text>
      <text class="menu-text">我的统计</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onMenuItem" data-type="setting">
      <text class="menu-icon">⚙️</text>
      <text class="menu-text">设置</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="menu-card">
    <view class="menu-item" bindtap="onMenuItem" data-type="about">
      <text class="menu-icon">ℹ️</text>
      <text class="menu-text">关于好用旅记</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onMenuItem" data-type="feedback">
      <text class="menu-icon">💬</text>
      <text class="menu-text">帮助与反馈</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="footer-info">
    <text>好用旅记 v1.0.0</text>
  </view>
</view>
