<view class="page-profile">
  <t-navbar title="个人中心" leftArrow bind:go-back="onBack" />

  <view class="profile-card">
    <view class="avatar-section">
      <view class="avatar-circle" style="background-color: #38C172">
        <text class="avatar-char">张</text>
      </view>
      <view class="user-info">
        <text class="user-name">张本友</text>
        <text class="user-desc">旅行记账达人</text>
      </view>
    </view>
  </view>

  <view class="menu-card">
    <view class="menu-item" bindtap="onMenuItem" data-type="vip">
      <text class="menu-icon">💎</text>
      <text class="menu-text">会员中心</text>
      <text class="menu-badge">免费用户</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onMenuItem" data-type="stats">
      <text class="menu-icon">📊</text>
      <text class="menu-text">我的统计</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onMenuItem" data-type="books">
      <text class="menu-icon">📒</text>
      <text class="menu-text">我的账本</text>
      <text class="menu-value">6个</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onMenuItem" data-type="setting">
      <text class="menu-icon">⚙️</text>
      <text class="menu-text">设置</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="menu-card">
    <view class="menu-item" bindtap="onMenuItem" data-type="about">
      <text class="menu-icon">ℹ️</text>
      <text class="menu-text">关于好用旅记</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onMenuItem" data-type="feedback">
      <text class="menu-icon">💬</text>
      <text class="menu-text">帮助与反馈</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="footer-info">
    <text>好用旅记 v1.0.0</text>
  </view>
</view>
