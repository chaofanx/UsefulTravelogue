<view class="book-header">
  <!-- 固定顶部导航栏：返回键 + 操作按钮，不随封面滚动 -->
  <nav-bar leftArrow frosted background="transparent" color="#fff" placeholder="{{false}}">
    <view slot="right" class="header-actions">
      <view class="action-btn" bindtap="onVip">
        <app-icon class="action-icon" name="vip" size="{{34}}" color="#ffffff" />
      </view>
      <view class="action-btn" bindtap="onOpenSetting">
        <app-icon class="action-icon" name="settings" size="{{34}}" color="#ffffff" />
      </view>
    </view>
  </nav-bar>

  <view class="header-cover" style="background-color: {{book.coverColor || '#4A90D9'}}">
    <image wx:if="{{book.cover}}" class="cover-bg-img" src="{{book.cover}}" mode="aspectFill" />
    <view class="cover-overlay" style="padding-right: {{capsuleLeft}}rpx;">
      <view class="header-top-bar" style="padding-top: {{statusBarHeight}}px; height: {{navBarHeight}}px;"></view>

      <view class="header-info">
        <view class="header-title">{{book.title}}</view>
        <view class="header-subtitle">
          <text wx:if="{{book.startDate}}">{{book.startDate}} 至 {{book.endDate}}</text>
          <text wx:else>{{book.date}}</text>
          <text> · 与{{memberCount}}位朋友一起</text>
          <text wx:if="{{book.ended}}" class="ended-tag">已结束</text>
        </view>
        <view class="header-members" bindtap="onMemberTap">
          <member-avatars members="{{book.members}}" maxShow="{{4}}" aliases="{{memberAliases}}" />
        </view>
      </view>
    </view>
  </view>

  <t-popup visible="{{showSettingPopup}}" placement="bottom" bind:visible-change="onSettingPopupVisible">
    <view class="setting-popup">
      <view class="popup-handle">
        <view class="handle-bar"></view>
      </view>
      <view class="popup-title">账本设置</view>

      <view class="setting-list">
        <view class="setting-item" bindtap="onChangeCover">
          <text class="setting-label">更换账本封面</text>
          <app-icon class="setting-arrow" name="chevron-right" size="{{32}}" color="#a6a6a6" />
        </view>

        <view class="setting-item" bindtap="onChangeName">
          <text class="setting-label">更换账本名称</text>
          <view class="setting-value-row">
            <text class="setting-value">{{book.title}}</text>
            <app-icon class="setting-arrow" name="chevron-right" size="{{32}}" color="#a6a6a6" />
          </view>
        </view>

        <view class="setting-item" bindtap="onChangeRange">
          <text class="setting-label">旅行范围</text>
          <view class="setting-value-row">
            <text class="setting-value">{{book.startDate ? book.startDate + ' 至 ' + book.endDate : '未设置，请补填'}}</text>
            <app-icon class="setting-arrow" name="chevron-right" size="{{32}}" color="#a6a6a6" />
          </view>
        </view>

        <view class="setting-item" bindtap="onAddMember">
          <text class="setting-label">增加成员</text>
          <app-icon class="setting-arrow" name="chevron-right" size="{{32}}" color="#a6a6a6" />
        </view>

        <view class="setting-item setting-danger" wx:if="{{isCreator}}" bindtap="onDisbandBook">
          <text class="setting-label danger-text">解散账本</text>
          <app-icon class="setting-arrow" name="chevron-right" size="{{32}}" color="#FF6B6B" />
        </view>
      </view>
    </view>
  </t-popup>

  <t-popup visible="{{showRenamePopup}}" placement="bottom" bind:visible-change="onRenamePopupVisible">
    <view class="rename-popup">
      <view class="popup-handle">
        <view class="handle-bar"></view>
      </view>
      <view class="popup-title">更换账本名称</view>
      <view class="name-input-wrap">
        <input
          class="name-input"
          placeholder="输入新名称（8字以内）"
          maxlength="8"
          value="{{editName}}"
          bindinput="onEditNameInput"
          focus="{{showRenamePopup}}"
        />
        <text class="name-count">{{editName.length}}/8</text>
      </view>
      <view class="popup-footer">
        <view class="footer-btn cancel-btn" bindtap="onCancelRename">取消</view>
        <view class="footer-btn confirm-btn" bindtap="onConfirmRename">确定</view>
      </view>
    </view>
  </t-popup>

  <t-popup visible="{{showRangePopup}}" placement="bottom" bind:visible-change="onRangePopupVisible">
    <view class="rename-popup">
      <view class="popup-handle">
        <view class="handle-bar"></view>
      </view>
      <view class="popup-title">旅行范围</view>
      <picker mode="date" value="{{editStart}}" bindchange="onEditStartChange">
        <view class="range-picker">
          <text class="range-label">开始日期</text>
          <text class="{{editStart ? '' : 'range-placeholder'}}">{{editStart || '请选择'}}</text>
        </view>
      </picker>
      <picker mode="date" value="{{editEnd}}" start="{{editStart}}" bindchange="onEditEndChange">
        <view class="range-picker">
          <text class="range-label">结束日期</text>
          <text class="{{editEnd ? '' : 'range-placeholder'}}">{{editEnd || '请选择'}}</text>
        </view>
      </picker>
      <view class="popup-footer">
        <view class="footer-btn cancel-btn" bindtap="onCancelRange">取消</view>
        <view class="footer-btn confirm-btn" bindtap="onConfirmRange">确定</view>
      </view>
    </view>
  </t-popup>

  <t-popup visible="{{showAddMemberPopup}}" placement="bottom" bind:visible-change="onAddMemberPopupVisible">
    <view class="add-member-popup">
      <view class="popup-handle">
        <view class="handle-bar"></view>
      </view>
      <view class="popup-title">增加成员</view>
      <view class="member-input-row">
        <view class="name-input-wrap">
          <input
            class="name-input"
            placeholder="输入成员名称"
            maxlength="10"
            value="{{newMemberName}}"
            bindinput="onNewMemberInput"
            bindconfirm="onConfirmAddMember"
            focus="{{showAddMemberPopup}}"
          />
        </view>
        <view class="add-btn" bindtap="onConfirmAddMember">添加</view>
      </view>
      <button class="invite-btn" open-type="share">邀请微信好友</button>
      <view class="current-members" wx:if="{{book.members.length > 0}}">
        <text class="members-tip">当前成员（点击"×"移除，{{isCreator ? '下方设置别名' : '仅创建者可设置别名'}}）：</text>
        <view class="member-alias-list">
          <view class="alias-row" wx:for="{{book.members}}" wx:key="id">
            <view class="member-tag">
              <text>{{item.name}}</text>
              <app-icon class="tag-remove" wx:if="{{index > 0}}" data-id="{{item.id}}" bindtap="onRemoveMember" name="close" size="{{26}}" color="#a6a6a6" />
            </view>
            <input
              wx:if="{{isCreator}}"
              class="alias-input-inline"
              placeholder="别名"
              value="{{memberAliases[item.name] || ''}}"
              data-name="{{item.name}}"
              bindinput="onAliasInput"
            />
            <text
              wx:if="{{isCreator && memberAliases[item.name]}}"
              class="alias-reset-inline"
              data-name="{{item.name}}"
              bindtap="onResetAlias"
            >恢复</text>
          </view>
        </view>
        <view class="save-aliases-btn" wx:if="{{isCreator}}" bindtap="onSaveAliases">
          <text>保存别名</text>
        </view>
      </view>
    </view>
  </t-popup>
</view>
