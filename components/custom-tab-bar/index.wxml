<view class="custom-tab-bar">
  <view
    wx:for="{{tabs}}"
    wx:key="key"
    class="tab-item {{current === item.key ? 'active' : ''}}"
    data-key="{{item.key}}"
    bindtap="onTabTap"
  >
    <app-icon name="{{item.icon}}" size="{{44}}" color="{{current === item.key ? '#38C172' : '#8b8b8b'}}" active="{{current === item.key}}" />
    <text class="tab-label">{{item.label}}</text>
  </view>
</view>
