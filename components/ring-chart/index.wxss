.ring-chart-container {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ring-canvas {
  width: 100%;
  height: 100%;
}

.ring-center {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.center-value {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--td-text-color-primary);
}

.center-sub {
  font-size: 22rpx;
  color: var(--td-text-color-placeholder);
  margin-top: 4rpx;
}
